{
  "name": "@workspace/db_drizzle",
  "version": "1.0.0",
  "description": "Database schema and utilities using Drizzle ORM with Cloudflare D1.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "LOCAL_DB_PATH=./data/development.sqlite drizzle-kit migrate",
    "db:d1:shared:migrate": "wrangler d1 migrations apply db_clawfeehouse --local --persist-to ./data/wrangler-state --config wrangler.jsonc",
    "db:d1:shared:reset": "rm -rf ./data/wrangler-state/v3",
    "db:studio": "LOCAL_DB_PATH=./data/development.sqlite drizzle-kit studio",
    "db:studio:local": "LOCAL_DB_PATH=./data/wrangler-state/v3/d1/miniflare-D1DatabaseObject/8c4adb7a51078a272a8336d1d6f606acb37a5564b94ce38b4862ef2734d493a1.sqlite drizzle-kit studio",
    "db:local": "pnpm run db:generate && pnpm run db:migrate:local && pnpm run db:studio",
    "build": "tsc",
    "test": "vitest",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "better-auth": "^1.6.2",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "~0.45.2"
  },
  "devDependencies": {
    "vitest": "^0.34.0",
    "eslint": "^8.0.0",
    "@types/node": "^24.0.3",
    "drizzle-kit": "~0.31.1",
    "typescript": "6.0.3",
    "wrangler": "^4.20.2"
  }
}
