{
  "name": "clawfeehouse",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "db:shared:prepare": "pnpm -F @workspace/db_drizzle run db:migrate:local",
    "db:shared:migrate": "pnpm -F @workspace/db_drizzle run db:d1:shared:migrate",
    "db:shared:sync": "pnpm run db:shared:prepare && pnpm run db:shared:migrate",
    "db:shared:reset": "pnpm -F @workspace/db_drizzle run db:d1:shared:reset",
    "dev:auth_sso": "pnpm -F @clawfeehouse/auth_sso run dev",
    "dev:admin": "pnpm -F admin run dev",
    "dev:gallery": "pnpm -F @clawfeehouse/gallery run dev",
    "dev:store": "pnpm -F @clawfeehouse/store run dev",
    "dev:commissioner": "pnpm -F @clawfeehouse/commissioner run dev",
    "dev:apps": "pnpm --parallel --stream --filter @clawfeehouse/auth_sso --filter admin --filter @clawfeehouse/gallery --filter @clawfeehouse/store --filter @clawfeehouse/commissioner run dev",
    "dev:apps:with-db": "pnpm run db:shared:sync && pnpm run dev:apps",
    "gallery:build": "pnpm -F gallery build",
    "studio:local": "pnpm -F studio run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.3.0"
}
